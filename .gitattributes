# PDFs are byte-exact (the xref table stores byte offsets); never convert their line endings.
*.pdf binary
# Shell scripts run under bash on Windows runners too, where CRLF breaks them.
*.sh text eol=lf
# SQL fixtures hold multi-line string values; CRLF on checkout would change the data the tests compare.
emmas_librarian/electron/database/__tests__/fixtures/*.sql text eol=lf
