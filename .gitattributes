# PDFs are byte-exact (the xref table stores byte offsets); never convert their line endings.
*.pdf binary
# Shell scripts run under bash on Windows runners too, where CRLF breaks them.
*.sh text eol=lf
# SQL fixtures hold multi-line string values; CRLF on checkout would change the data the tests compare.
emmas_librarian/core/database/__tests__/fixtures/*.sql text eol=lf

# The generated command schemas are compared byte by byte with what the generator writes (LF); CRLF on checkout fails
# `npm run schemas:check` on Windows runners (#201).
emmas_librarian/core/harness/commandSchemas.generated.json text eol=lf
