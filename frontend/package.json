{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "rebuild:electron": "electron-rebuild",
    "rebuild:node": "npm rebuild better-sqlite3",
    "electron:dev": "npm run rebuild:electron && tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "npm run rebuild:node && vitest",
    "coverage": "npm run rebuild:node && vitest run --coverage",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^11.0.0",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^4.4.168",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf-highlighter": "^8.0.0-rc.0",
    "react-router-dom": "^7.15.1"
  },
  "build": {
    "appId": "com.emma.librarian",
    "productName": "Emma's Librarian",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/database/schema.sql"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
