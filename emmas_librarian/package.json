{
  "name": "emmas_librarian",
  "author": "joaopedrov0",
  "description": "Emma's Librarian - A scientific library manager",
  "private": true,
  "version": "1.1.12",
  "repository": "https://github.com/mastrien/emmas_librarian",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "electron:dev": "npm run rebuild:electron && tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "npm run rebuild:node && vitest",
    "coverage": "npm run rebuild:node && vitest run --coverage",
    "test:mutate": "stryker run",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsdom": "^28.0.3",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.0.0",
    "electron": "41.7.1",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.0",
    "@types/lodash": "^4.17.24",
    "adm-zip": "^0.5.17",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.1",
    "citation-js": "^0.7.22",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "lodash": "^4.18.1",
    "lucide-react": "^1.16.0",
    "open": "^11.0.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-pdf-highlighter": "^7.0.0",
    "react-router-dom": "^7.15.1",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "^0.1.9",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.emma.librarian",
    "productName": "Emma's Librarian",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/database/schema.sql"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Emma's Librarian"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mastrien",
        "repo": "emmas_librarian"
      }
    ]
  }
}
