{
  "$schema": "https://schema.stryker-mutator.io/stryker-config.schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mts"
  },
  "mutate": [
    "electron/**/*.ts",
    "src/services/**/*.ts",
    "src/utils/**/*.ts",
    "!electron/services/types.ts",
    "!**/__tests__/**/*",
    "!**/*.test.ts"
  ],
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["temp_old_project_details.tsx"]
}
