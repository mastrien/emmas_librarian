{
  "$schema": "https://schema.stryker-mutator.io/stryker-config.schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "json"],
  "testRunner": "vitest",
  "concurrency": 6,
  "dryRunTimeoutMinutes": 30,
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "thresholds": { "high": 80, "low": 60, "break": null },
  "vitest": {
    "configFile": "vitest.config.mts"
  },
  "mutate": [
    "electron/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!**/__tests__/**/*",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.d.ts",
    "!electron/preload.ts",
    "!electron/main.ts",
    "!electron/types.ts",
    "!electron/services/types.ts",
    "!src/main.tsx",
    "!src/components/modals/changelog/releases.tsx",
    "!src/vite-env.d.ts"
  ],
  "tempDirName": ".stryker-tmp"
}
