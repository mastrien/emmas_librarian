{
  "compilerOptions": {
    "noImplicitAny": true,
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["adapters/**/*.ts", "core/**/*.ts"],
  "exclude": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
